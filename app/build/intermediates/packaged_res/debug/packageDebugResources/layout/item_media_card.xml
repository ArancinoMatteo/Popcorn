<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="120dp"
    android:layout_height="180dp"
    android:layout_marginEnd="8dp"
    app:cardBackgroundColor="@color/netflix_card_bg"
    app:cardCornerRadius="6dp"
    app:cardElevation="2dp">

    <ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Poster Image -->
        <ImageView
            android:id="@+id/iv_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/app_name"
            tools:src="@color/netflix_card_bg" />

        <!-- Fallback Title Label if no poster -->
        <TextView
            android:id="@+id/tv_fallback_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/pb_watch_progress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Inception" />

        <!-- Red Progress Bar for Continue Watching -->
        <ProgressBar
            android:id="@+id/pb_watch_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:progressDrawable="@drawable/progress_bar_red"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:progress="60"
            tools:visibility="visible" />

    </ConstraintLayout>

</androidx.cardview.widget.CardView>
